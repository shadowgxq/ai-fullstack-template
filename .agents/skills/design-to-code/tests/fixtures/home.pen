{
  "version": "2.8",
  "themes": {"mode": ["light", "dark"]},
  "variables": {
    "color.surface": {"type": "color", "value": [{"value": "#ffffff", "theme": {"mode": "light"}}, {"value": "#162032", "theme": {"mode": "dark"}}]},
    "color.primary": {"type": "color", "value": "#2454a6"},
    "space.page": {"type": "number", "value": 24}
  },
  "children": [
    {"id": "primary-button", "type": "frame", "name": "Primary button", "reusable": true, "layout": "horizontal", "width": 120, "height": 40, "cornerRadius": 8, "fill": "$color.primary", "children": [{"id": "button-label", "type": "text", "content": "Continue", "fontSize": 16, "fill": "#ffffff"}]},
    {"id": "home", "type": "frame", "name": "Home", "layout": "vertical", "width": 390, "height": 844, "padding": "$space.page", "gap": 16, "fill": "$color.surface", "children": [
      {"id": "title", "type": "text", "content": "Overview", "fontSize": 24, "fontWeight": "600"},
      {"id": "balance-card", "type": "frame", "layout": "vertical", "width": "fill_container", "height": 144, "cornerRadius": 12, "fill": "#f1f4f8", "children": [{"id": "balance-label", "type": "text", "content": "Sample balance"}, {"id": "balance-value", "type": "text", "content": "12,345.67", "fontSize": 32}]},
      {"id": "home-action", "type": "ref", "ref": "primary-button", "descendants": {"button-label": {"content": "View details"}}}
    ]},
    {"id": "home-dark", "type": "ref", "ref": "home", "theme": {"mode": "dark"}}
  ]
}
