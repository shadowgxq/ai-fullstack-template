{
  "name": "fullstack-miniprogram",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22 <23" },
  "scripts": {
    "dev:weapp": "pnpm generate && taro build --type weapp --watch",
    "build:weapp": "pnpm generate && taro build --type weapp",
    "generate": "pnpm tokens && pnpm contracts",
    "tokens": "node scripts/sync-tokens.mjs",
    "tokens:check": "node scripts/sync-tokens.mjs --check",
    "contracts": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src config scripts tests --max-warnings=0",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm tokens:check && pnpm contracts:check && pnpm typecheck && pnpm lint && pnpm test && pnpm format:check",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tanstack/react-query": "5.101.0",
    "@tarojs/components": "4.3.0",
    "@tarojs/helper": "4.3.0",
    "@tarojs/plugin-framework-react": "4.3.0",
    "@tarojs/plugin-platform-weapp": "4.3.0",
    "@tarojs/react": "4.3.0",
    "@tarojs/runtime": "4.3.0",
    "@tarojs/shared": "4.3.0",
    "@tarojs/taro": "4.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-transform-class-properties": "7.25.9",
    "@babel/preset-react": "^7.24.1",
    "@eslint/js": "9.39.4",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.17",
    "@tarojs/cli": "4.3.0",
    "@tarojs/taro-loader": "4.3.0",
    "@tarojs/webpack5-runner": "4.3.0",
    "@types/minimatch": "^5",
    "@types/node": "^22",
    "@types/react": "18.3.31",
    "babel-preset-taro": "4.3.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "17.6.0",
    "openapi-typescript": "^7.10.1",
    "postcss": "^8.5.6",
    "prettier": "3.6.2",
    "react-refresh": "^0.14.0",
    "sass": "^1.75.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.61.0",
    "vitest": "3.2.6",
    "webpack": "^5.91.0"
  },
  "pnpm": { "onlyBuiltDependencies": ["@swc/core", "esbuild"] },
  "browserslist": ["defaults and fully supports es6-module", "maintained node versions"]
}
