# Client runtime configuration. VITE_* values are exposed to browser code.
# 浏览器统一通过同源 /api 访问服务端。
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=30000
# 数据源：mock（本地数据）| api（真实服务；DEV_PROXY_TARGET 可覆盖默认开发代理）
# 缺省值也是 api——漏配时请求会直接失败，不会静默回落假数据。
# 只有在「还没有可用后端」时才到 .env.local 里显式改成 mock。
VITE_DATA_SOURCE=api
# 公司研究数据源：mock | api（已接接口默认使用 api，未覆盖能力不会回退 Mock）
VITE_RESEARCH_DATA_SOURCE=api
# Google Identity Services OAuth Client ID（公开标识，非密钥）
VITE_GOOGLE_CLIENT_ID=
# Google 登录链路：code = 自绘按钮 + OAuth 授权码流（要求后端 {code} 分支已上线且配了
# app.account.google.client-secret）；留空/其它值 = GIS ID token 流（按钮由 Google 在
# 跨域 iframe 内渲染，配色只能三选一）。构建期被 Vite 内联，改了要重新构建才生效。
VITE_GOOGLE_AUTH_MODE=

# Vite dev server configuration. These values are not exposed to browser code.
DEV_SERVER_PORT=5173
DEV_PROXY_PREFIX=/api
DEV_PROXY_TARGET=https://ai-bershire-product-server-production.up.railway.app
DEV_PROXY_SECURE=true

# Generate production source maps only when the deployment policy allows it.
BUILD_SOURCEMAP=false

# Docker/Railway container runtime configuration. Required when API mode is enabled.
BACKEND_ORIGIN=https://ai-bershire-product-server-production.up.railway.app
