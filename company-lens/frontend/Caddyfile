{
	admin off
	# Railway terminates TLS before forwarding HTTP traffic to the container.
	auto_https off
}

:{$PORT:8080} {
	encode gzip

	# Keep browser requests same-origin. BACKEND_ORIGIN can override the Railway default.
	@api path /api/*
	handle @api {
		reverse_proxy {$BACKEND_ORIGIN:https://ai-bershire-product-server-production.up.railway.app} {
			header_up Host {upstream_hostport}
		}
	}

	@assets path /assets/*
	handle @assets {
		header Cache-Control "public, max-age=2592000, immutable"
		root * /srv
		file_server
	}

	# Vite output is a SPA, so unknown paths must resolve to index.html.
	handle {
		header Cache-Control "no-cache"
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
