# Local development only. Do not expose this Compose stack publicly.
AI_API_KEY=local-ai-service-key-change-before-deploy
BACKEND_SECRET_KEY=local-backend-key-change-before-deploy

# Optional Backend-only WeChat credentials; leave empty until configured.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TIMEOUT_SECONDS=5

# Optional Backend-only reverse geocoder; never expose the key to clients.
TENCENT_MAP_KEY=
WEATHER_TIMEOUT_SECONDS=5
WEATHER_MAX_BYTES=524288

# Optional AI Worker model access; disabled until explicit configuration.
AI_MODEL_ENABLED=false
AI_MODEL_NAME=
AI_MODEL_BASE_URL=https://api.openai.com/v1
AI_MODEL_RESPONSE_TRANSPORT=responses-json.v1
AI_MODEL_REASONING_EFFORT=
AI_MODEL_API_KEY=
AI_MODEL_TIMEOUT_SECONDS=20
AI_MODEL_MAX_RESPONSE_BYTES=1048576
AI_MODEL_MAX_OUTPUT_TOKENS=2048

# Backend-only trusted AI HTTP client; Compose uses AI_API_KEY above.
AI_SERVICE_TIMEOUT_SECONDS=5
AI_SERVICE_MAX_RESPONSE_BYTES=1048576
