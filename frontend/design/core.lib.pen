{
  "version": "2.21",
  "children": [
    {
      "type": "frame",
      "id": "MKpT9",
      "x": 0,
      "y": 0,
      "name": "Core / Foundations",
      "theme": {
        "mode": "light"
      },
      "metadata": {
        "type": "token-projection",
        "source": "frontend/src/shared/styles/global.css",
        "policy": "docs/design/tokens.md",
        "fontProjection": "sans -> Noto Sans SC; mono -> IBM Plex Mono",
        "leadingProjection": "CSS line px / font px",
        "colorProjection": "oklch -> sRGB hex, rounded and gamut clipped"
