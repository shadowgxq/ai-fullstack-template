# Public browser settings. Secrets never belong in VITE_* variables.
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=20000
VITE_AUTH_DATA_SOURCE=api

# Local Vite integration, without rewriting /api/v1.
DEV_PROXY_TARGET=http://127.0.0.1:8000
DEV_PROXY_PREFIX=/api
DEV_PROXY_SECURE=true
DEV_SERVER_PORT=5173
BUILD_SOURCEMAP=false

# Optional translation adapter: not provided by this backend and disabled by default.
VITE_TRANSLATION_API_BASE_URL=/translation-api
VITE_TRANSLATION_TIMEOUT_MS=20000
DEV_TRANSLATION_PROXY_TARGET=

# Optional analytics: both values must be supplied explicitly to enable it.
VITE_UMAMI_SRC=
VITE_UMAMI_WEBSITE_ID=
