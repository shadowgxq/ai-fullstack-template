DATABASE_URL=postgresql+psycopg2://backend:backend-dev@localhost:5432/backend
SECRET_KEY=local-backend-key-change-before-deploy
REDIS_URL=redis://localhost:6379/0
# 微信登录仅在配置真实应用凭据后可用；Secret 不进入客户端产物。
# WECHAT_APP_ID=wx-your-app-id
# WECHAT_APP_SECRET=your-app-secret
WECHAT_TIMEOUT_SECONDS=5
# 私有持久目录，不能通过静态服务器公开。
MEDIA_ROOT=var/media
MEDIA_MAX_BYTES=10485760
MEDIA_MAX_PIXELS=25000000
MEDIA_MAX_DIMENSION=8192
# 地图仅用于用户主动定位；空 Key 不阻塞认证、目录搜索或手动选城。
TENCENT_MAP_KEY=
WEATHER_TIMEOUT_SECONDS=5
WEATHER_MAX_BYTES=524288
# 仅服务端访问受信 AI Runtime；空配置不阻塞衣柜/历史等核心接口。
AI_SERVICE_BASE_URL=
AI_SERVICE_API_KEY=
AI_SERVICE_TIMEOUT_SECONDS=5
AI_SERVICE_MAX_RESPONSE_BYTES=1048576
